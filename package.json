{
  "name": "@designliquido/delegua-entidades",
  "description": "Biblioteca Node.js com o intuito de trabalhar com entidades de dados, com base nas instruções da linguagem Delégua.",
  "version": "0.0.6",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "delegua-entidades": "./ilc/delegua-entidades.js"
  },
  "scripts": {
    "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./package.json ./dist && yarn copyfiles -u 1 ./fontes/ilc/manifesto-definicoes.json ./dist/ilc/",
    "publicar-npm": "npm publish ./dist --access public",
    "testes-unitarios": "jest --coverage",
    "lint": "eslint fontes/**/*.ts",
    "ilc": "ts-node fontes/ilc/delegua-entidades.ts",
    "migracoes": "ts-node fontes/ilc/migracoes.ts",
    "sementes": "ts-node fontes/ilc/semeadura.ts",
    "gerar-modelo": "ts-node fontes/ilc/gerador-entidades.ts",
    "gerar-definicoes": "ts-node fontes/ilc/gerador-definicoes.ts",
    "performance": "ts-node fontes/indicadores-performance/index.ts"
  },
  "delegua": {
    "definicoes": "./definicoes"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@designliquido/delegua": "^1.23.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "release-it": "^20.2.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@designliquido/delegua": "^1.16.3"
  },
  "dependencies": {
    "@designliquido/delprops": "^0.0.1",
    "@designliquido/flexoes": "^0.1.0",
    "@designliquido/lincones-js": "^0.2.3",
    "@designliquido/lincones-sqlite": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@designliquido/lincones-mysql": {
      "optional": true
    },
    "@designliquido/lincones-postgresql": {
      "optional": true
    }
  }
}
